# Set automatically by `lunar dashboard` (same-origin proxy on the dashboard port — preferred).
# VITE_USE_SAME_ORIGIN_WS=1
#
# Optional overrides when not using lunar dashboard. Default: browser hostname on 8770 / 8767.
# VITE_MISSION_WS_URL=ws://localhost:8770/mission/ws
# Set to 1 to force mock bridge only (no live WebSocket), e.g. pure UI development.
# VITE_MISSION_WS_DISABLE=1
# Build-time: same as disabling the mission WebSocket (pnpm dev:demo loads .env.demo with this set).
# VITE_FORCE_MOCK=1
# Runtime: add ?mock=1 to skip the mission WebSocket; ?scenario=terrain_lab (or nominal|degraded|offline) sets the initial mock scenario.
# Optional: full WebSocket origin for camera_ws.py (Tornado). When unset, the UI uses
# the current page hostname and VITE_CAMERA_WS_PORT (default 8767), matching Streamlit.
# VITE_CAMERA_WS_BASE_URL=ws://localhost:8767
# VITE_CAMERA_WS_PORT=8767
